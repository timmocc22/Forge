# demo produces labelled local HTML samples without paid model calls.
PROVIDER=demo
PORT=3007
WEB_ORIGIN=http://127.0.0.1:5177
DESKTOP_CLIENT_ENABLED=true
# Public build-time API endpoint, including /api; never place credentials here.
VITE_API_BASE_URL=
DATA_DIR=.data
# Only the API process reads model credentials. Never prefix them with VITE_.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_PROXY_URL=
OPENAI_TEXT_MODEL=
OPENAI_TEXT_MODELS=
# Independent text account and optional HTTP CONNECT proxy.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEXT_MODEL=deepseek-flash
DEEPSEEK_TEXT_MODELS=
DEEPSEEK_PROXY_URL=
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/v1
ZHIPU_TEXT_MODEL=glm-5.3
ZHIPU_TEXT_MODELS=glm-5.2,glm-5.3-flash
ZHIPU_PROXY_URL=
PROVIDER_TIMEOUT_MS=180000
MAX_CONCURRENT_JOBS=2
