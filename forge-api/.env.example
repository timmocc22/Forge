PROVIDER=demo
PORT=3009
WEB_ORIGIN=http://127.0.0.1:5179
DESKTOP_CLIENT_ENABLED=true
DATA_DIR=.data
# Optional read-only import from the old application's html-projects directory.
# IMPORT_LEGACY_DIR=/absolute/path/old/.data/html-projects
# DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/forge
# DATABASE_USER=forge
# DATABASE_PASSWORD=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=
OPENAI_TEXT_MODELS=
OPENAI_PROXY_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEXT_MODEL=deepseek-flash
DEEPSEEK_TEXT_MODELS=
DEEPSEEK_PROXY_URL=
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/v1
ZHIPU_TEXT_MODEL=glm-5.3
ZHIPU_TEXT_MODELS=glm-5.2,glm-5.3-flash
ZHIPU_PROXY_URL=
PROVIDER_TIMEOUT_MS=180000
MAX_CONCURRENT_JOBS=2
# Optional Python RAG service. Configure the same token in forge-knowledge/.env.
KNOWLEDGE_URL=
KNOWLEDGE_TOKEN=
# Enable only for a trusted internal service network (for example local Compose).
KNOWLEDGE_ALLOW_HTTP=false
