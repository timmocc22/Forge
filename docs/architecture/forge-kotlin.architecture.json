  "cards": [
    {
      "dot": "cyan",
      "title": "业务边界",
      "items": [
        "项目、对话、执行、模型适配按模块隔离；统一运行在一个后台进程。",
        "页面工具复用项目规则；前后端协议由 OpenAPI 生成类型。"
      ]
    },
    {
      "dot": "amber",
      "title": "一致性与恢复",
      "items": [
        "命令先落库；调用模型期间不持有事务，最终提交再检查版本。",
        "重启标记中断，手动重试复用检查点；外部模型调用可能重复。"
      ]
    },
    {
      "dot": "emerald",
      "title": "两种部署选择",
      "items": [
        "本地：Tauri + 本地 JVM 服务 + SQLite + 文件目录。",
        "云端：Web / Tauri + HTTPS 与项目授权 + PostgreSQL + 对象存储。"
