KNOWLEDGE_TOKEN=replace-with-a-shared-service-token
KNOWLEDGE_DATABASE_URL=sqlite:///.data/knowledge.db
# Cloud: postgresql+psycopg://forge:password@127.0.0.1:5432/forge_knowledge
KNOWLEDGE_EMBEDDING_BASE_URL=
KNOWLEDGE_EMBEDDING_API_KEY=
KNOWLEDGE_EMBEDDING_MODEL=
KNOWLEDGE_EMBEDDING_DIMENSION=1024
# Optional endpoint implementing POST {query,documents,top_n,model} -> {results:[{index,relevance_score}]}
KNOWLEDGE_RERANK_URL=
KNOWLEDGE_RERANK_API_KEY=
KNOWLEDGE_RERANK_MODEL=

# Optional explicit HTTP proxy for model calls; loopback services bypass environment proxies.
KNOWLEDGE_MODEL_PROXY_URL=
KNOWLEDGE_INGEST_WORKERS=1
KNOWLEDGE_MAX_QUEUED_JOBS=20
