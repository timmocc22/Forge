{
  "name": "forge",
  "version": "0.1.0",
  "private": true,
  "description": "HTML creation workspace with editable storyboards and page generation",
  "engines": {
    "node": "^20.19.0 || >=22.13.0",
    "pnpm": ">=9.6.0 <10"
  },
  "scripts": {
    "brand:icons": "node scripts/generate-brand-icons.mjs",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:dev:running": "tauri dev --config src-tauri/tauri.running.conf.json",
    "desktop:build": "tauri build",
    "desktop:build:web": "pnpm build:packages && pnpm --filter @studio/web build --mode desktop",
    "desktop:check": "cargo check --locked --manifest-path src-tauri/Cargo.toml",
    "dev": "pnpm build:packages && concurrently -k -n API,WEB -c cyan,magenta \"pnpm --filter @studio/api dev\" \"pnpm --filter @studio/web dev\"",
    "build:packages": "lerna run build --ignore @studio/web --ignore @studio/api",
    "build": "lerna run build",
    "typecheck": "lerna run typecheck",
    "lint": "eslint . && node scripts/check-boundaries.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "pnpm --filter @studio/api start"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.56.1",
    "@tauri-apps/cli": "2.11.5",
    "@types/express": "^5.0.5",
    "@types/node": "^22.19.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.2.1",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "^10.5.1",
    "globals": "^16.5.0",
    "lerna": "9.0.7",
    "less": "^4.4.2",
    "nx": "22.7.12",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.3.7",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.1"
  },
  "packageManager": "pnpm@9.6.0",
  "pnpm": {
    "overrides": {
      "@nestjs/platform-express>multer": "2.5.0"
    }
  }
}
